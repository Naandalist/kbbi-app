API_URL=https://raw.githubusercontent.com/Naandalist/

# Ads
SHOW_ADS=true
# Real AdMob native unit ID goes here (ca-app-pub-XXXXXXXX/YYYYYYYY).
# Left empty on purpose: this file is committed, .env is not.
# Without it, release builds fall back to Google's sample unit (earns nothing).
ADMOB_NATIVE_UNIT_ID=
